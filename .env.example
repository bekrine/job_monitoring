# ==============================================================================
# Morocco IT Job Monitoring Agent - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hugging Face AI Inference Settings
# ------------------------------------------------------------------------------
# HF_TOKEN: Required. Your Hugging Face user access token (fine-grained with "Inference: Make calls to the serverless Inference API" or Read permissions).
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN="hf_your_token_here"

# HF_MODEL: The Hugging Face model identifier to use.
# Verified default: "Qwen/Qwen2.5-Coder-7B-Instruct" (Verified live on router: nscale & featherless-ai, non-gated, ultra-low cost).
# Other options: "Qwen/Qwen2.5-Coder-3B-Instruct", "deepseek-ai/DeepSeek-R1-Distill-Qwen-7B", "google/gemma-3-4b-it".
HF_MODEL="Qwen/Qwen2.5-Coder-7B-Instruct"

# ------------------------------------------------------------------------------
# 2. Telegram Notification Settings
# ------------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN: The HTTP API token received from @BotFather on Telegram.
# Example: "123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_BOT_TOKEN="123456789:YOUR_TELEGRAM_BOT_TOKEN"

# TELEGRAM_CHAT_ID: The numeric chat or channel ID where alerts will be delivered.
# Send a message to @userinfobot or @getidsbot to find your personal chat ID.
# Example: "987654321" or channel "-1001234567890"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# ------------------------------------------------------------------------------
# 3. Optional Safety and Scraper Controls
# ------------------------------------------------------------------------------
# FIRST_RUN_MAX_NOTIFICATIONS: Cap on notifications sent on initial execution to prevent flooding (Default: 5).
FIRST_RUN_MAX_NOTIFICATIONS="5"

# MAX_NOTIFICATIONS_PER_RUN: Maximum notifications sent per routine scheduled execution (Default: 10).
MAX_NOTIFICATIONS_PER_RUN="10"

# TARGET_JOB_URL: Optional custom recruitment portal URL or RSS feed (Defaults to Emploi-Public.ma).
# TARGET_JOB_URL="https://www.emploi-public.ma/ar/قائمة-المباريات"
